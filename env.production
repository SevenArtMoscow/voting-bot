# Переменные окружения для продакшена
# Скопируйте этот файл в .env и заполните своими данными

# Токен бота (обязательно!)
BOT_TOKEN=YOUR_BOT_TOKEN

# ID администраторов (через запятую)
ADMIN_IDS=802373523,665509323

# Настройки базы данных
DATABASE_PATH=data/voting_bot.db

# Настройки голосования
VOTING_ACTIVE=true

# Настройки CAPTCHA
CAPTCHA_LENGTH=4
CAPTCHA_WIDTH=200
CAPTCHA_HEIGHT=100

# Папки для файлов
CAPTCHA_FOLDER=captcha_images
EXPORT_FOLDER=exports

# Настройки логирования
LOG_LEVEL=INFO
DEBUG=false

# Сайт ознакомления
SITE_URL=https://sevenartmoscow.github.io/voting-bot/
